const toolNames = [
 ["Карта интересов","Разберите позиции, потребности и общую цель."],
 ["Подготовка к переговорам","Соберите цель, факты, границы и варианты."],
 ["Конструктор BATNA","Оцените реалистичные альтернативы соглашению."],
 ["Конструктор Win-Win","Найдите несколько решений для обеих сторон."],
 ["Конструктор вопросов","Подготовьте открытые вопросы «Что?» и «Как?»."],
 ["Уважительный отказ","Сформулируйте ясный отказ без агрессии."]
];

const KEY = "cp-negotiation-pwa-v1";
let state = loadState();
let currentView = "home";
let currentLesson = null;
let deferredPrompt = null;

function loadState(){
 try{return Object.assign({done:[],notes:{},generalNote:"",profile:{name:"",format:"self",theme:"dark"}},JSON.parse(localStorage.getItem(KEY)||"{}"))}
 catch(e){return {done:[],notes:{},generalNote:"",profile:{name:"",format:"self",theme:"dark"}}}
}
function saveState(){localStorage.setItem(KEY,JSON.stringify(state));}
function applyTheme(){const theme=state.profile?.theme||"dark";document.documentElement.dataset.theme=theme;const meta=document.querySelector('meta[name="theme-color"]');if(meta)meta.content=theme==="light"?"#f4f6f8":theme==="emerald"?"#09251f":"#111a2b";}
function esc(s=""){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
function toast(msg){const el=document.getElementById("toast");el.textContent=msg;el.classList.add("show");setTimeout(()=>el.classList.remove("show"),1900);}
function allLessons(){return modules.flatMap(m=>m.lessons.map((l,i)=>({module:m,lesson:l,index:i,key:`${m.id}-${i}`})));}
function progress(){const all=allLessons();return all.length?Math.round(state.done.length/all.length*100):0;}
function setView(view){currentView=view;currentLesson=null;render();document.querySelectorAll(".nav-item").forEach(b=>b.classList.toggle("active",b.dataset.view===view));window.scrollTo({top:0,behavior:"smooth"});}
function render(){
 applyTheme();
 const app=document.getElementById("app");
 if(currentView==="home") app.innerHTML=homeView();
 if(currentView==="learn") app.innerHTML=learnView();
 if(currentView==="module") app.innerHTML=moduleView(window.__moduleId);
 if(currentView==="lesson") app.innerHTML=lessonView();
 if(currentView==="slides") app.innerHTML=slidesView();
 if(currentView==="tools") app.innerHTML=toolsView();
 if(currentView==="notes") app.innerHTML=notesView();
 if(currentView==="profile") app.innerHTML=profileView();
 bindDynamic();
}
function homeView(){
 const pct=progress();
 return `<section class="hero">
  <div class="eyebrow">Центр Притяжения • авторский практикум</div>
  <h1>Искусство эффективных <span class="gold">переговоров</span></h1>
  <div class="lead">От противостояния к партнёрству. Интерактивный учебник, практические тренажёры и личный инструментарий переговорщика.</div>
  <div class="actions"><button class="btn" data-action="go-learn">Продолжить обучение →</button><button class="btn secondary" data-action="go-tools">Открыть инструменты</button></div>
  <div class="progress"><span style="width:${pct}%"></span></div><p class="small">Ваш учебный прогресс: ${pct}% • сохраняется на этом устройстве</p>
 </section>
 <div class="section-head"><div><h2>Ваш маршрут обучения</h2><p>Можно пройти самостоятельно или использовать на практикуме с ведущим.</p></div><span class="pill">8 модулей</span></div>
 <div class="grid">
  <article class="card"><div class="card-top"><span class="symbol">▤</span><span class="pill">Обучение</span></div><h3>Теория и уроки</h3><p>Короткие материалы, примеры фраз, вопросы для самопроверки.</p></article>
  <article class="card"><div class="card-top"><span class="symbol">◇</span><span class="pill">Практика</span></div><h3>Инструменты</h3><p>Карты интересов, BATNA, Win-Win и конструкторы диалогов.</p></article>
  <article class="card"><div class="card-top"><span class="symbol">✎</span><span class="pill">Личное</span></div><h3>Мои записи</h3><p>Заметки и выводы хранятся локально на вашем устройстве.</p></article>
 </div>
 <div class="section-head"><div><h2>Начните с одного шага</h2><p>Выберите формат прохождения.</p></div></div>
 <div class="grid">
  <button class="card" data-action="format-workshop"><div class="card-top"><span class="symbol">◷</span><span class="pill">3 часа</span></div><h3>С ведущим</h3><p>Используйте модули как сопровождение очного практикума: задания, заметки, разборы.</p></button>
  <button class="card" data-action="format-self"><div class="card-top"><span class="symbol">◎</span><span class="pill">В своём темпе</span></div><h3>Самостоятельно</h3><p>Изучайте теорию, выполняйте упражнения и собирайте личную стратегию.</p></button>
  <button class="card" data-action="go-slides"><div class="card-top"><span class="symbol">▧</span><span class="pill">Визуальные материалы</span></div><h3>Презентация</h3><p>Открывайте слайды практикума в отдельной галерее.</p></button>
 </div>
 <div class="footer-note">Учебные материалы носят образовательный характер. Содержание не заменяет профессиональную юридическую, психологическую или иную специализированную консультацию.</div>`;
}
function learnView(){
 return `<div class="eyebrow">Учебная программа</div><h2>Модули обучения</h2><p class="lead">Двигайтесь последовательно или откройте нужную тему под свою задачу.</p><div class="module-list">${modules.map(m=>{
  const count=m.lessons.filter((l,i)=>state.done.includes(`${m.id}-${i}`)).length;
  return `<button class="module-row" data-module="${m.id}"><span class="module-num">${String(m.id).padStart(2,"0")}</span><span><b>${esc(m.title)}</b><p>${esc(m.desc)} • ${count}/${m.lessons.length} уроков</p></span><span class="arrow">›</span></button>`
 }).join("")}</div>`;
}
function moduleView(id){
 const m=modules.find(x=>x.id===id); if(!m)return learnView();
 return `<button class="btn ghost" data-action="go-learn">← Все модули</button><div class="section-head"><div><div class="eyebrow">Модуль ${m.id}</div><h2>${esc(m.title)}</h2><p>${esc(m.desc)}</p></div></div><div class="module-list">${m.lessons.map((l,i)=>{
  const key=`${m.id}-${i}`,done=state.done.includes(key);
  return `<button class="module-row" data-lesson="${key}"><span class="module-num">${done?"✓":i+1}</span><span><b>${esc(l[0])}</b><p>${esc(l[1])}</p></span><span class="arrow">›</span></button>`
 }).join("")}</div>`;
}
