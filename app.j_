      "Какой навык станет вашим следующим фокусом?"
    ],
    "quiz": [
      "Корректная оценка прогресса опирается на…",
      [
        "Только впечатление «мне понравилось»",
        "Наблюдаемые действия, примеры и обратную связь",
        "Количество использованных сложных терминов"
      ],
      1,
      "Наблюдаемые примеры и обратная связь помогают оценить перенос навыка в практику."
    ],
    "note": "Переговорные навыки развиваются постепенно. Итог практикума — начало практики, а не обещание мгновенного мастерства."
  }
};

function lessonView(){
 if(currentLesson===null)return learnView();
 const [mid,idx]=currentLesson.split("-").map(Number),m=modules.find(x=>x.id===mid),l=m.lessons[idx],key=currentLesson,done=state.done.includes(key);
 const g=lessonGuides[key];
 const examples = {
  "1-0":["Работа: руководитель и сотрудник обсуждают срыв срока. Вместо взаимных обвинений стороны уточняют, что именно мешает завершить задачу и какой результат реалистичен.","Быт: близкие спорят, куда поехать в выходные. Вместо борьбы за направление каждый объясняет, что для него важно: отдых, бюджет, дорога или время вместе."],
  "1-1":["Работа: позиция — «Нужен отчёт сегодня». Возможный интерес — подготовить материалы к встрече с руководством и снизить риск ошибки.","Быт: позиция — «Давай купим именно эту машину». Интерес может быть в безопасности, экономии на ремонте или удобстве для семьи."],
  "1-2":["Работа: после резкого замечания коллеги не отвечайте тем же. Уточните конкретный факт и предложите обсудить решение отдельно от оценки личности.","Быт: если разговор о домашних обязанностях накаляется, договоритесь о паузе и вернитесь к вопросу с конкретным распределением дел."],
  "1-3":["Работа: «У нас разные оценки срока. Давайте посмотрим на объём работ и доступные ресурсы».","Быт: «Я вижу, что тебе важно успеть сегодня. Давай решим, что действительно необходимо сделать сейчас, а что можно перенести»."],
  "2-0":["Работа: перед разговором о повышении подготовьте желаемый результат, вклад, рыночные данные и несколько вариантов договорённости.","Быт: перед крупной покупкой определите бюджет, обязательные требования, желательные опции и предел, за который не готовы выходить."],
  "2-1":["Работа: если подрядчик не принимает условия, заранее оцените другого поставщика, перенос сроков или выполнение части работ своими силами.","Быт: если не удаётся договориться о поездке, альтернативой может быть другой маршрут, даты или формат отдыха. Оцените реальную стоимость каждого варианта."],
  "2-2":["Работа: сравните предложения подрядчиков по срокам, стоимости, гарантиям и подтверждённому качеству, а не только по обещаниям.","Быт: при выборе ремонта сравните сметы, материалы, сроки и отзывы по одинаковым критериям."],
  "2-3":["Работа: можно согласовать не только цену, но и объём, этапность, сроки оплаты или поддержку после запуска.","Быт: при распределении домашних дел учтите время, нагрузку и предпочтения каждого, а не делите обязанности механически пополам."],
  "3-0":["Работа: «Похоже, вас беспокоит, что изменение требований повлияет на сроки. Верно понимаю?»","Быт: «Кажется, тебя расстроило, что планы изменились в последний момент. Я правильно услышал?»"],
  "3-1":["Работа: «Мы не успеем к пятнице». — «К пятнице?» Затем выдержите паузу: собеседник может сам объяснить причину.","Быт: «Ты опять всё решил сам». — «Сам?» Спокойно дайте человеку раскрыть, что именно его задело."],
  "3-2":["Работа: «Похоже, вас настораживает риск для качества». Это гипотеза, а не утверждение о чувствах коллеги.","Быт: «Кажется, ты сейчас чувствуешь себя неуслышанным». Дайте близкому возможность подтвердить или поправить вас."],
  "3-3":["Работа: «Что должно быть готово, чтобы вы могли согласовать этот этап?»","Быт: «Как мы можем распределить расходы так, чтобы обоим было спокойно?»"],
  "3-4":["Работа: после вопроса о причинах задержки дайте коллеге время ответить, не подсказывая за него.","Быт: в споре о семейном бюджете выдержите паузу после вопроса «Что для тебя здесь самое важное?»"],
  "4-0":["Работа: перед сложной встречей назовите про себя эмоцию, отделите факты от предположений и выберите цель разговора.","Быт: если раздражены из-за опоздания, сначала восстановите спокойствие, а затем обсуждайте договорённость о времени."],
  "4-1":["Работа: если собеседник требует немедленного ответа, спокойно обозначьте, какие данные нужны для решения и когда вы вернётесь с ответом.","Быт: если близкий замыкается, не навешивайте ярлык «безразличный». Спросите, удобно ли поговорить сейчас или позже."],
  "4-2":["Работа: «Спасибо, что предложили. Я не смогу взять дополнительный проект до конца месяца. Могу помочь определить приоритеты».","Быт: «Я не готов сегодня ехать. Давай выберем другой день или встретимся ближе к дому»."],
  "4-3":["Работа: на фразу «Если не сделаете, найдём другого» ответьте: «Понимаю важность срока. Давайте уточним обязательный объём и критерии качества».","Быт: на давление «Если любишь, то согласишься» ответьте: «Мне важны наши отношения, и мне нужно обсудить решение без давления»."],
  "5-0":["Семья: вместо «Ты никогда не помогаешь» обсудите конкретные задачи, нагрузку и приемлемое распределение.","Повседневность: при выборе места встречи учтите время в пути, бюджет и доступность для каждого."],
  "5-1":["Работа: вместо «Вы опять сорвали срок» спросите: «Что мешает завершить задачу и какая дата теперь реалистична?»","Быт: при договорённости с мастером заранее зафиксируйте объём, стоимость, сроки и способ сообщить об изменениях."],
  "5-2":["Работа: клиенту честно обозначьте ограничения продукта и предложите подходящий вариант, не обещая невозможного.","Быт: при покупке услуги уточните, что входит в стоимость, какие есть дополнительные расходы и как решаются спорные ситуации."],
  "6-0":["Работа: «Понимаю, что запуск к понедельнику важен. Что можно упростить, чтобы соблюсти срок без критичной потери качества?»","Быт: «Вижу, что тебе важно провести праздник дома. Как организовать его так, чтобы учесть бюджет и наши силы?»"],
  "6-1":["Команда проекта, жители, бизнес и экологическая группа получают разные приоритеты. Задача — не победить, а найти условия, которые стороны готовы поддержать.","В бытовом варианте представьте семью, выбирающую место отдыха: у каждого есть бюджет, сроки, интересы и ограничения."],
  "6-2":["Работа: после встречи зафиксируйте, что помогло договориться, где потеряли время и что изменить в следующем раунде.","Быт: после сложного разговора спросите себя, что вы услышали, что осталось неясным и какой следующий шаг укрепит договорённость."],
  "7-0":["Работа: выберите собственную последовательность — подготовить факты, прояснить интересы, предложить варианты, закрепить ответственность.","Быт: используйте короткий алгоритм в разговоре о семейных планах: цель, интересы, варианты, договорённость."],
  "8-0":["Работа: в ближайшие 72 часа проведите один разговор, где примените открытый вопрос вместо готового возражения.","Быт: договоритесь с близкими о небольшом вопросе, который давно откладывали, и попробуйте сначала выяснить интересы."],
  "8-1":["Работа: оцените не только достигнутый результат, но и качество процесса — ясность, уважение, реалистичность обязательств.","Быт: отметьте одну фразу или привычку, которая помогла услышать друг друга, и повторите её в следующем разговоре."]
 };
 const slideMap={"1-0":[2],"1-1":[3],"1-2":[4],"1-3":[5],"2-0":[12],"2-1":[13],"2-2":[14],"2-3":[15],"3-0":[6,16],"3-1":[7,17],"3-2":[7,18],"3-3":[8,19],"3-4":[20],"4-0":[21],"4-1":[22],"4-2":[23],"4-3":[11],"5-0":[9,24],"5-1":[9,25],"5-2":[9,26],"6-0":[27],"6-1":[28],"6-2":[29],"7-0":[10,30],"8-0":[31],"8-1":[32]};
 const slideNums=slideMap[key]||[],lessonSlides=slideNums.map(n=>({n,title:slides.find(x=>x[0]===n)?.[1]}));
 const ex=examples[key]||["Профессиональная ситуация: уточните задачу, интересы, ограничения и критерии результата до того, как предлагать решение.","Повседневная ситуация: попробуйте применить тот же принцип в разговоре с близкими — спокойно, конкретно и с уважением к обеим сторонам."];
 return `<button class="btn ghost" data-module="${mid}">← ${esc(m.title)}</button><div class="lesson-layout lesson-screen" style="margin-top:16px"><aside class="sidebar card"><div class="eyebrow">Модуль ${mid}</div><b>${esc(m.title)}</b><div class="lesson-nav">${m.lessons.map((x,i)=>`<button class="${i===idx?"active":""}" data-lesson="${mid}-${i}">${i+1}. ${esc(x[0])}</button>`).join("")}</div></aside><section class="lesson-body"><div class="lesson-panel"><div class="eyebrow">Урок ${idx+1} • теория и практика</div><h2>${esc(l[0])}</h2><p>${esc(l[1])}</p><div class="callout">${esc(l[2])}</div><section class="lesson-objective"><div class="eyebrow">Результат обучения</div><p>${esc(g.goal)}</p></section><h3>Ключевые идеи</h3><ul class="lesson-keypoints">${g.points.map(x=>`<li>${esc(x)}</li>`).join("")}</ul><h3>Примеры из жизни и работы</h3><div class="example example-pro"><b>Профессиональная сфера</b><p>${esc(ex[0])}</p></div><div class="example example-life"><b>Бытовая сфера</b><p>${esc(ex[1])}</p></div><section class="lesson-practice"><h3>Практическое упражнение</h3><p class="small">Выполните шаги последовательно. Можно использовать собственную ситуацию или примеры выше.</p><ol>${g.practice.map(x=>`<li>${esc(x)}</li>`).join("")}</ol></section><h3>Вопросы для закрепления</h3><ol class="lesson-questions">${g.questions.map(x=>`<li>${esc(x)}</li>`).join("")}</ol><details class="lesson-check"><summary>Мини-проверка: проверить себя</summary><p><b>${esc(g.quiz[0])}</b></p><ol type="A">${g.quiz[1].map((x,i)=>`<li>${esc(x)}${i===g.quiz[2]?' <strong>— правильный ответ</strong>':''}</li>`).join("")}</ol><p class="small">${esc(g.quiz[3])}</p></details>${g.note?`<div class="lesson-note"><b>Методическая оговорка</b><p>${esc(g.note)}</p></div>`:''}${lessonSlides.length?lessonSlides.map(slide=>`<div class="lesson-slide"><div class="card-top"><div><span class="pill">Слайд ${slide.n}</span><h3>${esc(slide.title)}</h3></div></div><button class="slide-open" type="button" data-open-slide="${slide.n}" aria-label="Открыть слайд ${slide.n} в просмотрщике"><img src="assets/slide-${String(slide.n).padStart(2,"0")}.jpg" alt="${esc(slide.title)}" loading="lazy"></button><p class="small">Нажмите, чтобы увеличить слайд. Вернуться к уроку можно кнопкой «Назад к уроку».</p></div>`).join(""):""}<h3>Мои выводы</h3><textarea id="lessonNote" placeholder="Запишите свои мысли, примеры и формулировки...">${esc(state.notes[key]||"")}</textarea><div class="actions"><button class="btn" data-action="save-lesson" data-key="${key}">Сохранить заметку</button><button class="btn secondary" data-action="toggle-done" data-key="${key}">${done?"✓ Урок пройден":"Отметить урок пройденным"}</button></div></div></section></div>`;
}
function slidesView(){
 return `<div class="eyebrow">Визуальная библиотека</div><h2>Слайды практикума</h2><p class="lead">Полный комплект визуальных материалов практикума — от титульного слайда до итогов обучения.</p><div class="slide-grid">${slides.map(([n,title])=>`<article class="slide-card"><img loading="lazy" src="assets/slide-${String(n).padStart(2,"0")}.jpg" alt="Слайд ${n}: ${esc(title)}"><div><span class="pill">Слайд ${n}</span><h3>${esc(title)}</h3></div></article>`).join("")}</div><p class="small" style="margin-top:14px">В этой сборке включены все 32 слайда презентации. Слайды №2–4 также встроены в соответствующие уроки первого модуля.</p>`;
}
function toolsView(){
 return `<div class="eyebrow">Личный инструментарий</div><h2>Инструменты переговорщика</h2><p class="lead">Заполняйте поля — результат можно сохранить в заметки или скопировать для подготовки к разговору.</p><div class="tool-grid">
 <section class="card"><h3>Карта интересов</h3><div class="field"><label>Моя позиция</label><textarea id="myPos" placeholder="Чего я хочу?"></textarea></div><div class="field"><label>Мой интерес</label><textarea id="myInt" placeholder="Почему это важно?"></textarea></div><div class="field"><label>Позиция другой стороны</label><textarea id="theirPos" placeholder="Что говорит собеседник?"></textarea></div><div class="field"><label>Возможный интерес другой стороны</label><textarea id="theirInt" placeholder="Что может быть для него важно?"></textarea></div><div class="field"><label>Общий интерес / цель</label><textarea id="sharedInt" placeholder="Что может объединить стороны?"></textarea></div><button class="btn" data-action="build-map">Собрать карту</button><div id="mapOut" class="output" hidden></div></section>
 <section class="card"><h3>Подготовка к переговорам</h3><div class="field"><label>Моя цель</label><input id="prepGoal" placeholder="Какого результата хочу?"></div><div class="field"><label>Факты и критерии</label><textarea id="prepFacts" placeholder="На какие данные опираюсь?"></textarea></div><div class="field"><label>Границы и гибкость</label><textarea id="prepLimits" placeholder="Что обязательно, чем могу быть гибким?"></textarea></div><div class="field"><label>Варианты решения</label><textarea id="prepOptions" placeholder="Какие варианты предложу?"></textarea></div><button class="btn" data-action="build-prep">Собрать план</button><div id="prepOut" class="output" hidden></div></section>
 <section class="card"><h3>Конструктор BATNA</h3><div class="field"><label>Если соглашение не состоится, я могу…</label><textarea id="batnaList" placeholder="Перечислите доступные альтернативы"></textarea></div><div class="field"><label>Какая альтернатива наиболее реалистична?</label><textarea id="batnaBest" placeholder="Выберите лучшую и объясните почему"></textarea></div><div class="field"><label>Что важно проверить?</label><textarea id="batnaCheck" placeholder="Сроки, затраты, риски, последствия"></textarea></div><button class="btn" data-action="build-batna">Собрать BATNA</button><div id="batnaOut" class="output" hidden></div></section>
 <section class="card"><h3>Конструктор Win-Win</h3><div class="field"><label>Что важно мне?</label><textarea id="winMe"></textarea></div><div class="field"><label>Что важно другой стороне?</label><textarea id="winThem"></textarea></div><div class="field"><label>Какие варианты можем рассмотреть?</label><textarea id="winOptions"></textarea></div><button class="btn" data-action="build-win">Найти точки пересечения</button><div id="winOut" class="output" hidden></div></section>
 <section class="card"><h3>Конструктор вопросов</h3><div class="field"><label>Ситуация</label><textarea id="questionSituation" placeholder="Кратко опишите предмет переговоров"></textarea></div><button class="btn" data-action="build-questions">Подобрать вопросы</button><div id="questionsOut" class="output" hidden></div></section>
 <section class="card"><h3>Уважительный отказ</h3><div class="field"><label>На что нужно отказать?</label><textarea id="noRequest" placeholder="Что от вас просят?"></textarea></div><div class="field"><label>Что вы можете предложить вместо этого?</label><textarea id="noAlternative" placeholder="Альтернатива, другой срок или формат (необязательно)"></textarea></div><button class="btn" data-action="build-no">Сформулировать отказ</button><div id="noOut" class="output" hidden></div></section>
 </div>`;
}
function notesView(){
 const entries=Object.entries(state.notes).filter(([k,v])=>v.trim());
 return `<div class="eyebrow">Личное пространство</div><h2>Мои записи</h2><p class="lead">Заметки хранятся на этом устройстве. Для важных материалов периодически копируйте их в свой документ.</p><section class="card"><h3>Свободные заметки</h3><textarea id="generalNote" placeholder="Идеи, выводы, фразы, которые хочу запомнить...">${esc(state.generalNote||"")}</textarea><div class="actions"><button class="btn" data-action="save-general">Сохранить</button><button class="btn secondary" data-action="export-notes">Экспортировать записи</button></div></section><div class="section-head"><div><h2>Заметки по урокам</h2><p>${entries.length} сохранённых записей</p></div></div>${entries.length?entries.map(([k,v])=>{const [mi,li]=k.split("-").map(Number);const m=modules.find(x=>x.id===mi);return `<div class="note-item"><b>${esc(m?.lessons[li]?.[0]||k)}</b><p>${esc(v).replace(/\\n/g,"<br>")}</p><small>Модуль ${mi}</small></div>`}).join(""):`<div class="empty">Пока нет заметок по урокам. Откройте урок и запишите свои выводы.</div>`}`;
}
function profileView(){
 return `<div class="eyebrow">Ваш учебный профиль</div><h2>Мой прогресс</h2><section class="card"><div class="card-top"><h3>Обучение</h3><span class="pill">${progress()}%</span></div><div class="progress"><span style="width:${progress()}%"></span></div><p>${state.done.length} из ${allLessons().length} уроков отмечено как пройденные.</p><div class="field"><label>Как к вам обращаться (необязательно)</label><input id="profileName" value="${esc(state.profile.name||"")}" placeholder="Ваше имя"></div><div class="field"><label>Формат обучения</label><select id="profileFormat"><option value="self" ${state.profile.format==="self"?"selected":""}>Самостоятельно</option><option value="workshop" ${state.profile.format==="workshop"?"selected":""}>С ведущим на практикуме</option><option value="both" ${state.profile.format==="both"?"selected":""}>Оба формата</option></select></div><div class="field"><label>Цветовая схема приложения</label><div class="theme-picker"><button class="theme-choice ${state.profile.theme==="dark"?"selected":""}" data-theme-choice="dark"><span class="theme-swatch swatch-dark"></span><b>Тёмная</b><small>Исходная</small></button><button class="theme-choice ${state.profile.theme==="emerald"?"selected":""}" data-theme-choice="emerald"><span class="theme-swatch swatch-emerald"></span><b>Изумрудная</b><small>Глубокая зелень</small></button><button class="theme-choice ${state.profile.theme==="light"?"selected":""}" data-theme-choice="light"><span class="theme-swatch swatch-light"></span><b>Светлая</b><small>Дневной режим</small></button></div></div><button class="btn" data-action="save-profile">Сохранить профиль</button></section><section class="card" style="margin-top:14px"><h3>Данные, установка и офлайн-режим</h3><p>После первого открытия с интернетом приложение сохраняет оболочку, уроки, слайды и рабочую тетрадь для дальнейшего использования офлайн. Прогресс, заметки и тема сохраняются на этом устройстве. При очистке данных браузера они могут быть удалены. Облачной синхронизации между устройствами пока нет.</p><p class="small">iPhone: откройте приложение в Safari → «Поделиться» → «На экран Домой». Android: используйте кнопку установки в верхней панели или пункт «Установить приложение» в меню браузера.</p><div class="actions"><button class="btn secondary" data-action="export-all">Скачать резервную копию</button><button class="btn ghost" data-action="reset-progress">Сбросить прогресс</button></div></section>`;
}
function bindDynamic(){}
function openModule(id){window.__moduleId=id;currentView="module";render();document.querySelectorAll(".nav-item").forEach(b=>b.classList.toggle("active",b.dataset.view==="learn"));}
function openLesson(key){currentLesson=key;currentView="lesson";render();document.querySelectorAll(".nav-item").forEach(b=>b.classList.toggle("active",b.dataset.view==="learn"));}
function exportJSON(filename,data){const blob=new Blob([JSON.stringify(data,null,2)],{type:"application/json"});const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download=filename;a.click();URL.revokeObjectURL(a.href);}
let slideViewerOpen = false;
let slideViewerNumber = null;
function openSlideViewer(number){
 const n=Number(number); if(!Number.isInteger(n)||n<1||n>32)return;
 const modal=document.getElementById("slideViewer");
 const img=document.getElementById("slideViewerImage");
 const title=document.getElementById("slideViewerTitle");
 if(!modal||!img||!title)return;
 slideViewerNumber=n;
 img.src=`assets/slide-${String(n).padStart(2,"0")}.jpg`;
 img.alt=`Слайд ${n}: ${slides.find(x=>x[0]===n)?.[1]||""}`;
 title.textContent=`Слайд ${n} из 32`;
 modal.hidden=false; modal.setAttribute("aria-hidden","false");
 document.body.classList.add("viewer-open"); slideViewerOpen=true;
 document.getElementById("slideViewerClose")?.focus();
}
function closeSlideViewer(){
 if(!slideViewerOpen)return;
 const modal=document.getElementById("slideViewer");
 if(modal){modal.hidden=true;modal.setAttribute("aria-hidden","true");}
 document.body.classList.remove("viewer-open"); slideViewerOpen=false; slideViewerNumber=null;
}
document.addEventListener("keydown",e=>{if(e.key==="Escape"&&slideViewerOpen)closeSlideViewer();});

// Capture slide-viewer controls before page navigation handlers. Slides stay inside the app.
document.addEventListener("click",e=>{
 const target=e.target instanceof Element ? e.target : null;
 const slideOpen=target?.closest("[data-open-slide]");
 if(slideOpen){e.preventDefault();e.stopImmediatePropagation();openSlideViewer(slideOpen.dataset.openSlide);return;}
 const slideClose=target?.closest("#slideViewerClose, .slide-viewer-x");
 if(slideClose){e.preventDefault();e.stopImmediatePropagation();closeSlideViewer();return;}
 if(target?.id==="slideViewer"){e.preventDefault();closeSlideViewer();return;}
 const nav=e.target.closest("[data-view]");if(nav){setView(nav.dataset.view);return;}
 const mod=e.target.closest("[data-module]");if(mod){openModule(Number(mod.dataset.module));return;}
 const lesson=e.target.closest("[data-lesson]");if(lesson){openLesson(lesson.dataset.lesson);return;}
 const themeChoice=e.target.closest("[data-theme-choice]");if(themeChoice){state.profile.theme=themeChoice.dataset.themeChoice;saveState();render();toast("Цветовая схема изменена");return;}
 const action=e.target.closest("[data-action]");if(!action)return;
 const a=action.dataset.action;
 if(a==="go-learn")setView("learn");
 if(a==="go-tools")setView("tools");
 if(a==="go-slides")setView("slides");
 if(a==="format-workshop"){state.profile.format="workshop";saveState();toast("Формат практикума выбран");setView("learn")}
 if(a==="format-self"){state.profile.format="self";saveState();toast("Самостоятельный формат выбран");setView("learn")}
 if(a==="save-lesson"){const key=action.dataset.key;state.notes[key]=document.getElementById("lessonNote").value;saveState();toast("Заметка сохранена")}
 if(a==="toggle-done"){const key=action.dataset.key;state.done=state.done.includes(key)?state.done.filter(x=>x!==key):[...state.done,key];saveState();render();toast("Прогресс обновлён")}
 if(a==="save-general"){state.generalNote=document.getElementById("generalNote").value;saveState();toast("Запись сохранена")}
 if(a==="export-notes")exportJSON("moi-zametki-peregovory.json",{notes:state.notes,generalNote:state.generalNote});
 if(a==="save-profile"){state.profile.name=document.getElementById("profileName").value;state.profile.format=document.getElementById("profileFormat").value;saveState();toast("Профиль сохранён")}
 if(a==="export-all")exportJSON("backup-peregovory.json",state);
 if(a==="reset-progress"){if(confirm("Сбросить отметки о пройденных уроках? Заметки останутся.")){state.done=[];saveState();render();toast("Прогресс сброшен")}}
 if(a==="build-map"){const v=[["Моя позиция",val("myPos")],["Мой интерес",val("myInt")],["Позиция другой стороны",val("theirPos")],["Возможный интерес другой стороны",val("theirInt")],["Общая цель",val("sharedInt")]];showOut("mapOut",v)}
 if(a==="build-prep"){showOut("prepOut",[["Цель",val("prepGoal")],["Факты и критерии",val("prepFacts")],["Границы и гибкость",val("prepLimits")],["Варианты",val("prepOptions")]])}
 if(a==="build-batna"){showOut("batnaOut",[["Альтернативы",val("batnaList")],["Лучшая альтернатива",val("batnaBest")],["Что проверить",val("batnaCheck")]])}
 if(a==="build-win"){showOut("winOut",[["Мои интересы",val("winMe")],["Интересы другой стороны",val("winThem")],["Варианты",val("winOptions")],["Вопрос для обсуждения","Какой вариант учитывает самое важное для обеих сторон?"]])}
 if(a==="build-questions"){const s=val("questionSituation");const txt=`Ситуация: ${s||"не указана"}\\n\\n• Что для вас здесь самое важное?\\n• Как вы предлагаете учесть это ограничение?\\n• Что должно измениться, чтобы решение стало приемлемым?\\n• Какие варианты мы ещё не рассмотрели?`;const el=document.getElementById("questionsOut");el.hidden=false;el.textContent=txt}
 if(a==="build-no"){const req=val("noRequest"),alt=val("noAlternative");const txt=`Спасибо, что обратились. Сейчас я не могу согласиться на: ${req||"это предложение"}.${alt?" Вместо этого могу предложить: "+alt+".":""} Давайте обсудим, подойдёт ли такой вариант.`;const el=document.getElementById("noOut");el.hidden=false;el.textContent=txt}
});
function val(id){return document.getElementById(id)?.value?.trim()||""}
function showOut(id,rows){const el=document.getElementById(id);el.hidden=false;el.textContent=rows.map(([a,b])=>`${a}: ${b||"—"}`).join("\n\n");}
render();
window.addEventListener("beforeinstallprompt",e=>{e.preventDefault();deferredPrompt=e;const b=document.getElementById("installBtn");b.hidden=false;});
document.getElementById("installBtn").addEventListener("click",async()=>{if(!deferredPrompt){toast("Откройте меню браузера и выберите «Добавить на экран Домой»");return;}deferredPrompt.prompt();await deferredPrompt.userChoice;deferredPrompt=null;});
if("serviceWorker" in navigator && location.protocol.startsWith("http"))window.addEventListener("load",()=>navigator.serviceWorker.register("./sw.js",{updateViaCache:"none"}).then(reg=>reg.update()).catch(()=>{}));
