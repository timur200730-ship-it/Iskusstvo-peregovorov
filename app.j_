const modules = [
 {id:1,title:"Основы переговоров",desc:"От противостояния к пониманию интересов",lessons:[
  ["Переговоры начинаются с понимания","Смысл переговоров — не победить человека, а разобраться в задаче и найти рабочее решение.","Начинайте разговор с прояснения ситуации. Отделяйте человека от проблемы и не торопитесь доказывать свою правоту."],
  ["Позиции и интересы","Позиция — то, что человек заявляет. Интерес — почему это для него важно.","За требованием «сделать сегодня» может стоять страх сорвать срок, сохранить репутацию или избежать дополнительных затрат."],
  ["Конфликт и реакция","В напряжении мы часто защищаемся, атакуем или избегаем разговора.","Заметьте собственную реакцию, сделайте паузу и вернитесь к фактам, интересам и следующему шагу."],
  ["Партнёрская позиция","Взрослый—Взрослый: уважение, ясность, ответственность и равное достоинство.","Не переходите на обвинения и назидание. Обсуждайте конкретную ситуацию и возможные решения."]
 ]},
 {id:2,title:"Подготовка и стратегия",desc:"Цель, BATNA, критерии и взаимная выгода",lessons:[
  ["Подготовка к переговорам","Определите желаемый результат, интересы сторон, факты, варианты и пределы гибкости.","Запишите цель одним предложением. Подготовьте минимум два варианта решения и критерии, по которым будете их оценивать."],
  ["BATNA: ваша альтернатива","BATNA — лучшая реалистичная альтернатива, если соглашение не достигнуто.","Это не угроза и не ультиматум. Сравнивайте предлагаемое соглашение со своей лучшей доступной альтернативой."],
  ["Объективные критерии","Опирайтесь на проверяемые основания: стандарты, рыночные цены, данные, правила и экспертные оценки.","Предложите критерий до спора о выводах: «Давайте сравним варианты по срокам, стоимости и качеству»."],
  ["Win-Win","Ищите варианты, которые учитывают существенные интересы обеих сторон.","Не путайте взаимную выгоду с уступкой во всём. Сначала расширьте набор вариантов, затем выбирайте."]
 ]},
 {id:3,title:"Понимание собеседника",desc:"Слушание, эмпатия и точные вопросы",lessons:[
  ["Тактическая эмпатия","Покажите, что вы услышали позицию и эмоции человека, не обязательно соглашаясь с ним.","«Похоже, вас беспокоит риск задержки. Правильно понимаю?»"],
  ["Зеркалирование","Кратко повторите последние значимые слова собеседника с заинтересованной интонацией.","— «Мы не успеем к пятнице». — «Не успеете к пятнице?» Используйте естественно, не превращайте в механическое эхо."],
  ["Маркировка эмоций","Мягко назовите возможное чувство: «Кажется, это вас обеспокоило…».","Формулируйте предположительно. Не ставьте диагноз и дайте человеку возможность поправить вас."],
  ["Калиброванные вопросы","Открытые вопросы «Что?» и «Как?» помогают перейти от спора к поиску решения.","«Что для вас здесь самое важное?» «Как мы можем учесть это ограничение?»"],
  ["Пауза и тишина","Пауза помогает не отвечать автоматически и даёт собеседнику время подумать.","После важного вопроса не торопитесь заполнять тишину. Не используйте молчание как наказание."]
 ]},
 {id:4,title:"Сложные разговоры",desc:"Эмоции, давление, границы и отказ",lessons:[
  ["Эмоциональный интеллект","Управляйте не эмоциями как таковыми, а выбором своей реакции.","Назовите своё состояние, замедлитесь, отделите факт от интерпретации и выберите следующий шаг."],
  ["Сложные модели поведения","Давящий, критичный, отстранённый или эмоциональный стиль — это поведение в ситуации, а не ярлык личности.","Подстройте формат общения: больше фактов, ясная структура, признание эмоций или конкретные вопросы."],
  ["Как говорить «нет»","Уважительный отказ сочетает ясность, краткость и сохранение достоинства обеих сторон.","«Спасибо, что предложили. Сейчас я не могу взять это обязательство. Могу вернуться к вопросу в следующий вторник»."],
  ["Давление и возражения","Сохраняйте спокойствие, уточняйте суть возражения и обозначайте границы.","Не отвечайте на провокацию провокацией. Возвращайте разговор к предмету, критериям и вариантам."]
 ]},
 {id:5,title:"Переговоры в жизни и работе",desc:"Семья, команда, клиенты и партнёры",lessons:[
  ["Семейные переговоры","Учитывайте потребности близких, распределяйте обязанности и фиксируйте договорённости.","«Что для каждого из нас важно? Какой вариант будет удобен обоим?»"],
  ["Переговоры на работе","Согласуйте цели, ресурсы, сроки, ответственность и критерии результата.","Вместо «Вы опять задержали» — «Что мешает завершить задачу и какой срок реалистичен?»"],
  ["Клиенты и партнёры","Долгосрочное сотрудничество строится на прозрачности, доверии и взаимной выгоде.","Не обещайте того, что нельзя выполнить. Проверяйте ожидания и проговаривайте ограничения."]
 ]},
 {id:6,title:"Практические тренажёры",desc:"Пробуйте, анализируйте, улучшайте",lessons:[
  ["Словесное айкидо","Примите позицию, отразите смысл, перенаправьте разговор к решению и договоритесь о следующем шаге.","«Понимаю, что сроки для вас критичны. Что можно изменить, чтобы успеть без потери качества?»"],
  ["Мост над пропастью","Ролевая симуляция, где стороны с разными интересами создают общее решение.","Бизнес, экология, жители и проектная команда получают свои интересы и ограничения. Ищите конструкцию, а не победителя."],
  ["Разбор переговоров","Разделите факты, интерпретации, эмоции, удачные действия и выводы.","Спросите себя: что сработало, где возникло напряжение, что попробую иначе в следующий раз?"]
 ]},
 {id:7,title:"Моя личная стратегия",desc:"Соберите собственную систему переговоров",lessons:[
  ["Личный алгоритм","Объедините подготовку, контакт, понимание, поиск вариантов, соглашение и контроль.","Выберите 1–2 сильных инструмента и определите, в каких ситуациях будете их применять."]
 ]},
 {id:8,title:"Закрепление навыка",desc:"Перенос обучения в реальную жизнь",lessons:[
  ["Шаг на 72 часа","Навык закрепляется через конкретное действие в реальной ситуации.","Запишите: что сделаю, когда, какой инструмент применю и как пойму, что получилось."],
  ["Итоговая рефлексия","Оцените свой прогресс и выберите следующий навык для развития.","Сформулируйте один вывод и одну привычку, которую будете поддерживать."]
 ]}
];

